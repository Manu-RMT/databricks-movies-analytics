{
  "datasets": [
    {
      "name": "998c053f",
      "displayName": "total_movies",
      "queryLines": [
        "select \r\n",
        "count(*) as total_movies \r\n",
        "from workspace.03_gold.fact_movies;"
      ],
      "catalog": "workspace",
      "schema": "03_gold"
    },
    {
      "name": "83d3e8ae",
      "displayName": "total_movies par year",
      "queryLines": [
        "select \r\n",
        "count(*) as total_movies, \r\n",
        "YEAR(release_date) as release_year\r\n",
        "from workspace.03_gold.fact_movies\r\n",
        "group by YEAR(release_date)\r\n",
        "order by 2 desc\r\n",
        ";"
      ],
      "catalog": "workspace",
      "schema": "03_gold"
    },
    {
      "name": "8070dccf",
      "displayName": "P1_budget_revenu_roi_global",
      "queryLines": [
        "SELECT \r\n",
        "sum(budget) as total_budget,\r\n",
        "sum(revenue) as total_revenue,\r\n",
        "-- ROI global (ensemble budget)\r\n",
        "(sum(revenue) - sum(budget)) / sum(budget) AS roi_global\r\n",
        "FROM fact_movies\r\n",
        "WHERE budget > 0 ;"
      ],
      "catalog": "workspace",
      "schema": "03_gold"
    },
    {
      "name": "2f384897",
      "displayName": "%_film_rentables",
      "queryLines": [
        "SELECT\r\n",
        "    (SUM(CASE WHEN revenue > budget THEN 1 ELSE 0 END) / count(*)) * 100 as pct_film_rentable\r\n",
        "FROM fact_movies;"
      ],
      "catalog": "workspace",
      "schema": "03_gold"
    },
    {
      "name": "ef53e398",
      "displayName": "KPI_GLOBAL",
      "queryLines": [
        "-- =====================================================\r\n",
        "-- Vue KPI globale des films\r\n",
        "-- Contient les métriques globales de performance\r\n",
        "-- =====================================================\r\n",
        "SELECT\r\n",
        "-- Nombre total de films\r\n",
        "   COUNT(*) AS total_films,\r\n",
        "-- Budget total investi\r\n",
        "   SUM(budget) AS total_budget,\r\n",
        "-- Revenus totaux générés\r\n",
        "   SUM(revenue) AS total_revenue,\r\n",
        "-- Profit global\r\n",
        "   SUM(revenue - budget) AS total_profit,\r\n",
        "-- ROI moyen des films\r\n",
        "   AVG((revenue - budget)/NULLIF(budget,0)) AS roi_moyen,\r\n",
        "-- Popularité moyenne catalogue\r\n",
        "   AVG(popularity) AS popularite_moyenne,\r\n",
        "-- Note moyenne utilisateurs\r\n",
        "   AVG(vote_average) AS note_moyenne,\r\n",
        "-- Nombre moyen de votes\r\n",
        "   AVG(vote_count) AS votes_moyens,\r\n",
        "-- Revenu médian (plus robuste que moyenne)\r\n",
        "   percentile_approx(revenue, 0.5) AS revenu_median,\r\n",
        "-- Pourcentage de films rentables\r\n",
        "   SUM(CASE WHEN revenue > budget THEN 1 ELSE 0 END) / COUNT(*)\r\n",
        "       AS pct_films_rentables    \r\n",
        "FROM fact_movies f\r\n",
        "\r\n",
        ";\r\n",
        "\r\n",
        "/*\r\n",
        ",\r\n",
        "d.year,\r\n",
        "d.month_name\r\n",
        "\r\n",
        "LEFT join dim_date d\r\n",
        "on f.release_date = d.date\r\n",
        "GROUP BY d.year,\r\n",
        "   d.month_name\r\n",
        "*/"
      ],
      "catalog": "workspace",
      "schema": "03_gold"
    },
    {
      "name": "afe44289",
      "displayName": "kpi _per_year",
      "queryLines": [
        "-- =====================================================\r\n",
        "-- Vue KPI globale des films\r\n",
        "-- Contient les métriques globales de performance\r\n",
        "-- =====================================================\r\n",
        "SELECT\r\n",
        "-- Nombre total de films\r\n",
        "   COUNT(*) AS total_films,\r\n",
        "-- Budget total investi\r\n",
        "   SUM(budget) AS total_budget,\r\n",
        "-- Revenus totaux générés\r\n",
        "   SUM(revenue) AS total_revenue,\r\n",
        "-- Profit global\r\n",
        "   SUM(revenue - budget) AS total_profit,\r\n",
        "-- ROI moyen des films\r\n",
        "   AVG((revenue - budget)/NULLIF(budget,0)) AS roi_moyen,\r\n",
        "-- Popularité moyenne catalogue\r\n",
        "   AVG(popularity) AS popularite_moyenne,\r\n",
        "-- Note moyenne utilisateurs\r\n",
        "   AVG(vote_average) AS note_moyenne,\r\n",
        "-- Nombre moyen de votes\r\n",
        "   AVG(vote_count) AS votes_moyens,\r\n",
        "-- Revenu médian (plus robuste que moyenne)\r\n",
        "   percentile_approx(revenue, 0.5) AS revenu_median,\r\n",
        "-- Pourcentage de films rentables\r\n",
        "   SUM(CASE WHEN revenue > budget THEN 1 ELSE 0 END) / COUNT(*)\r\n",
        "       AS pct_films_rentables,\r\n",
        "d.year\r\n",
        "FROM fact_movies f\r\n",
        "LEFT join dim_date d\r\n",
        "on f.release_date = d.date\r\n",
        "GROUP BY d.year\r\n",
        ";"
      ],
      "catalog": "workspace",
      "schema": "03_gold"
    },
    {
      "name": "c6692875",
      "displayName": "KPI_PAR_GENRE",
      "queryLines": [
        "-- =====================================================\r\n",
        "-- Performance financière et audience par genre\r\n",
        "-- =====================================================\r\n",
        "SELECT\r\n",
        "-- Nom du genre\r\n",
        "   g.genre,\r\n",
        "-- Nombre de films par genre\r\n",
        "   COUNT(*) nb_films,\r\n",
        "-- Revenus totaux générés\r\n",
        "   SUM(f.revenue) revenue_total,\r\n",
        "-- Budget moyen investi\r\n",
        "   AVG(f.budget) budget_moyen,\r\n",
        "-- ROI moyen\r\n",
        "   AVG((f.revenue - f.budget)/NULLIF(f.budget,0)) roi_moyen,\r\n",
        "-- Popularité moyenne\r\n",
        "   AVG(f.popularity) popularite_moyenne,\r\n",
        "-- Note moyenne public\r\n",
        "   AVG(f.vote_average) note_moyenne,\r\n",
        "-- Volatilité des revenus (mesure du risque)\r\n",
        "   STDDEV(f.revenue) volatilite_revenue\r\n",
        "FROM fact_movies f\r\n",
        "-- Jointure table relation film-genre\r\n",
        "JOIN rel_movies_genre rg\r\n",
        "   ON f.id = rg.id_film\r\n",
        "-- Dimension genre\r\n",
        "JOIN dim_movies_genre g\r\n",
        "   ON rg.id_genre = g.id\r\n",
        "GROUP BY g.genre;"
      ],
      "catalog": "workspace",
      "schema": "03_gold"
    }
  ],
